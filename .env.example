# このファイルをコピーして .env を作成してください（.env は Git に上がりません）
#   cp .env.example .env

# Claude API キー。空のままなら模擬モードで動きます
ANTHROPIC_API_KEY=

# 使用するモデル名
ANTHROPIC_MODEL=claude-sonnet-5-5

# auto: APIキーがあれば Claude API、なければ模擬 / live: 必ず API / mock: 必ず模擬
GUARDRAIL_MODE=auto

# 回答の最大トークン数（暴走したときの費用の上限）
MAX_TOKENS=2048

# AIが考える量（low / medium / high / xhigh / max）。文書作成の補助なので low で十分。空にすると API に送りません
EFFORT=low

# 1回の入力の上限文字数。超えた入力は送信せずに止めます
MAX_INPUT_CHARS=8000

# 推定費用の計算用（100万トークンあたり USD）。既定値は claude-sonnet-5-5 の料金
# モデルを変えるときは、公式の料金表を確認して合わせてください
PRICE_INPUT_USD_PER_MTOK=2
PRICE_OUTPUT_USD_PER_MTOK=10

# USAGE_LOG_PATH=logs/usage.jsonl
# DICTIONARY_DIR=data/dictionaries
